#!/usr/bin/env bash
# Blocks a commit whose message credits an AI, before the commit exists.
#
# Enable in a fresh clone (it is per-clone, git does not ship hooks):
#   git config core.hooksPath .githooks
#
# Then check it, because a clone that thinks it is protected is worse than one
# that knows it is not:
#   git config --get core.hooksPath      # must print .githooks
#   git rev-parse --git-path hooks      # must end in .githooks/
#
# If that second one prints some other directory, this hook is not running, and
# neither is .githooks/pre-push. The usual cause is a global core.hooksPath in
# ~/.gitconfig or /etc/gitconfig: local config beats global, but a fresh clone
# has no local config yet, so until you set one the global path wins and git
# looks for hooks there instead. No tracked file in this repository can prevent
# that — hooksPath is read from config before git decides which hooks exist, so
# nothing committed is ever consulted. Setting it per clone is the fix;
# `git config --global init.templateDir <dir>` carrying the same setting is the
# once-per-machine one.
#
# This hook is the only guard. CI does not re-run it, so a clone that skips
# this (see above) can land a credited commit on a branch.
set -euo pipefail
exec "$(git rev-parse --show-toplevel)/tools/assert-no-ai-credit.sh" --message-file "$1"
