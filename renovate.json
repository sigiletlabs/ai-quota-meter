{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":configMigration"
  ],
  "timezone": "Australia/Melbourne",
  "schedule": ["before 6am on monday"],

  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "description": "A known CVE waits for nothing: no schedule, no cooling period.",
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "labels": ["security"]
  },

  "customManagers": [
    {
      "description": "Container pins inside scripts/ci.sh. Renovate cannot see a version in a shell script without the renovate: marker comment above it.",
      "customType": "regex",
      "managerFilePatterns": ["/^scripts/ci\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?\\s+\\S+_IMAGE=\\S+:(?<currentValue>\\S+)"
      ]
    },
    {
      "description": "The trivy version passed to trivy-action. Pinning the action does not pin the scanner it downloads.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+version: (?<currentValue>\\S+)"
      ]
    }
  ],

  "packageRules": [
    {
      "description": "Security tooling does not wait for Monday. A scanner a week behind is a scanner that misses a week of detections.",
      "matchPackageNames": [
        "aquasec/trivy",
        "aquasecurity/trivy",
        "aquasecurity/trivy-action",
        "trufflesecurity/trufflehog",
        "github/codeql-action"
      ],
      "schedule": ["at any time"],
      "labels": ["security-tooling"],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "This program has no third-party dependencies on purpose. The only gomod update that exists is the go directive itself.",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Action digest bumps are noise one at a time. Group them.",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
