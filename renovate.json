{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":configMigration"
  ],
  "timezone": "Australia/Melbourne",
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "description": "This program has no third-party dependencies on purpose. The only gomod update that exists is the go directive itself.",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Action digest bumps are noise one at a time. Group them.",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
